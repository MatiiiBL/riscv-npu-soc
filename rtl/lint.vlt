`verilator_config

// rv32_pkg is the complete encoding table of the core; not every module uses
// every constant, and the full table is clearer than one trimmed to usage.
lint_off -rule UNUSEDPARAM -file "*rv32_pkg.sv"

// The IMEM array is a ROM: its contents come from $readmemh(INIT_FILE) on the
// FPGA or from the simulator's ELF loader, so with no INIT_FILE nothing in
// the RTL drives it.
lint_off -rule UNDRIVEN -file "*bram_sp.sv" -match "*'mem'*"
